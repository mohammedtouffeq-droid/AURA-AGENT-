{
  "version": 2,
  "git": {
    "submodules": false
  },
  "builds": [
    {
      "src": "aura_web.py",
      "use": "@vercel/python"
    },
    {
      "src": "index.html",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "aura_web.py"
    },
    {
      "src": "/(.*)",
      "dest": "index.html"
    }
  ]
}

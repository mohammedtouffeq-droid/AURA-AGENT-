{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index?__aura_path__=/api/$1"
    },
    {
      "source": "/v1/(.*)",
      "destination": "/api/index?__aura_path__=/v1/$1"
    },
    {
      "source": "/(manifest\\.json|sw\\.js)",
      "destination": "/api/index?__aura_path__=/$1"
    },
    {
      "source": "/((?!api/|v1/|manifest\\.json|sw\\.js).*)",
      "destination": "/index.html"
    }
  ]
}

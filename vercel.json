{
  "version": 2,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), geolocation=(), usb=(), bluetooth=()" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index?__aura_path__=/api/$1"
    },
    {
      "source": "/v1/(.*)",
      "destination": "/api/index?__aura_path__=/v1/$1"
    },
    {
      "source": "/(manifest\\.json|sw\\.js|aura_wallpapers\\.js|aura_offline_mobile\\.js|remote)",
      "destination": "/api/index?__aura_path__=/$1"
    },
    {
      "source": "/((?!api/|v1/|manifest\\.json|sw\\.js|aura_wallpapers\\.js|aura_offline_mobile\\.js|remote).*)",
      "destination": "/index.html"
    }
  ]
}
